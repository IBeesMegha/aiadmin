DATABASE_URL="postgresql://postgres:root@localhost:5433/strap_admin"

# JWT Secrets - CHANGE THESE IN PRODUCTION!
JWT_ACCESS_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"

# Hugging Face API Key for embeddings + LLM (free tier available)
# Get your key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="your-huggingface-api-key-here"

# Groq API Key (optional fallback LLM if HuggingFace is unavailable)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key-here"

